{
	"schemaVersion": 1,
	"id": "claritymod",
	"version": "${version}",
	"name": "Clarity Mod",
	"description": "Support and clarity improvements for the Nostalgic Reverie modpack.",
	"authors": [
		"creeereater"
	],
	"contact": {
		"homepage": "https://discord.com/invite/urgaDHUueu"
	},
	"license": "CC0-1.0",
