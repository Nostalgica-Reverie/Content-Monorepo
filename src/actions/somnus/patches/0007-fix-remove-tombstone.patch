Date: Fri, 27 Jun 2026 00:00:00 -0500
Subject: [PATCH 7/7] patch 0007: fix CacheIndexHandle.Remove to use tombstone

Patch 0004 introduced parallel downloads. Multiple goroutines can now
hold handles for the same cached file (same hash) simultaneously. When
one goroutine's reuseExistingFile fails and calls Remove(), the original
implementation used slices.Delete which shifts all higher hashIdx values
down by one. Any other goroutine holding a handle with a higher hashIdx
then writes to the wrong slot when it calls UpdateIndex().

Fix: replace the delete with an empty-string tombstone. Empty entries
are already compacted at startup by removeEmpty() in CreateDownloadSession,
so the tombstone approach is fully consistent with the existing design.

---
 core/download.go | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/core/download.go b/core/download.go
index a1b2c3d..b4c5d6e 100644
--- a/core/download.go
+++ b/core/download.go
@@ -1100,13 +1100,11 @@ func (h *CacheIndexHandle) UpdateIndex() (warnings []error) {
 	return
 }

 func (h *CacheIndexHandle) Remove() {
-	for hashFormat := range h.Hashes {
+	// Tombstone rather than delete so that other goroutines' handle.hashIdx
+	// values remain valid. removeEmpty() compacts these on next startup.
+	for hashFormat := range h.Hashes {
 		hashList := h.index.Hashes[hashFormat]
 		if h.hashIdx < len(hashList) {
-			h.index.Hashes[hashFormat] = slices.Delete(hashList, h.hashIdx, h.hashIdx+1)
+			hashList[h.hashIdx] = ""
 		}
 	}
-	return
 }
