From: omo50 <144749186+omo50@users.noreply.github.com>
Date: Fri, 27 Jun 2026 00:00:00 -0500
Subject: [PATCH 11/11] patch 0011: retry transient HTTP failures in GetWithUA

Modrinth and GitHub CDN occasionally return 5xx or drop connections
under load, especially in CI where many goroutines hit the same endpoints
at once (patches 0003/0005 made that worse)

---
 core/download.go | 27 ++++++++++++++++++++++++---
 1 file changed, 24 insertions(+), 3 deletions(-)

diff --git a/core/download.go b/core/download.go
index a1b2c3d..b4c5d6e 100644
--- a/core/download.go
+++ b/core/download.go
@@ -7,6 +7,7 @@ import (
 	"net/http"
 	"os"
 	"path/filepath"
 	"runtime"
 	"strings"
 	"sync"
+	"time"

 	"slices"
 )
@@ -80,12 +81,34 @@ const UserAgent = "packwiz/packwiz"

 func GetWithUA(url string, contentType string) (resp *http.Response, err error) {
-	req, err := http.NewRequest("GET", url, nil)
-	if err != nil {
-		return nil, err
+	const maxRetries = 3
+	backoff := 500 * time.Millisecond
+	for attempt := 0; attempt <= maxRetries; attempt++ {
+		if attempt > 0 {
+			time.Sleep(backoff)
+			backoff *= 2
+		}
+		req, reqErr := http.NewRequest("GET", url, nil)
+		if reqErr != nil {
+			return nil, reqErr
+		}
+		req.Header.Set("User-Agent", UserAgent)
+		req.Header.Set("Accept", contentType)
+		resp, err = http.DefaultClient.Do(req)
+		if err == nil && resp.StatusCode < 500 {
+			return resp, nil
+		}
+		if resp != nil {
+			_ = resp.Body.Close()
+			resp = nil
+		}
 	}
-	req.Header.Set("User-Agent", UserAgent)
-	req.Header.Set("Accept", contentType)
-	return http.DefaultClient.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	return nil, fmt.Errorf("request to %s failed after %d retries", url, maxRetries)
 }

