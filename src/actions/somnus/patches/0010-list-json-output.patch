From 0000000000000000000000000000000000000010 Mon Sep 17 00:00:00 2001
From: omo50 <144749186+omo50@users.noreply.github.com>
Date: Fri, 27 Jun 2026 00:00:00 -0500
Subject: [PATCH 10/11] patch 0010: add --json flag to packwiz list

Without machine-readable output, tooling that wraps packwiz e.g. somnus
status / modlist has to read .pw.toml files directly. The list command
already loads every Mod struct; emitting JSON costs nothing extra and
gives callers a stable interface

Output is a JSON array of objects

---
 cmd/list.go | 29 ++++++++++++++++++++++++++---
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/cmd/list.go b/cmd/list.go
index a1b2c3d..b4c5d6e 100644
--- a/cmd/list.go
+++ b/cmd/list.go
@@ -1,6 +1,7 @@
 package cmd

 import (
+	"encoding/json"
 	"fmt"
 	"os"
 	"sort"
@@ -55,6 +56,27 @@ var listCmd = &cobra.Command{
 		sort.Slice(mods, func(i, j int) bool {
 			return strings.ToLower(mods[i].Name) < strings.ToLower(mods[j].Name)
 		})

+		// JSON output
+		if viper.GetBool("list.json") {
+			type entry struct {
+				Name      string   `json:"name"`
+				FileName  string   `json:"filename"`
+				Side      string   `json:"side,omitempty"`
+				Pin       bool     `json:"pin,omitempty"`
+				Platforms []string `json:"platforms,omitempty"`
+			}
+			out := make([]entry, len(mods))
+			for i, mod := range mods {
+				var plats []string
+				for k := range mod.Update {
+					plats = append(plats, k)
+				}
+				sort.Strings(plats)
+				out[i] = entry{mod.Name, mod.FileName, mod.Side, mod.Pin, plats}
+			}
+			data, _ := json.MarshalIndent(out, "", "  ")
+			fmt.Println(string(data))
+			return
+		}
+
 		// Print mods
 		if viper.GetBool("list.version") {
 			for _, mod := range mods {
@@ -68,5 +90,8 @@ func init() {
 	listCmd.Flags().BoolP("version", "v", false, "Print name and version")
 	_ = viper.BindPFlag("list.version", listCmd.Flags().Lookup("version"))
 	listCmd.Flags().StringP("side", "s", "", "Filter mods by side (e.g., client or server)")
 	_ = viper.BindPFlag("list.side", listCmd.Flags().Lookup("side"))
+	listCmd.Flags().Bool("json", false, "Output as JSON array instead of plain text")
+	_ = viper.BindPFlag("list.json", listCmd.Flags().Lookup("json"))

 }
