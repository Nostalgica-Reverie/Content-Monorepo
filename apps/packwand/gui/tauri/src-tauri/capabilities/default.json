{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the bundled boot page and the loopback Packwand GUI. Only the local backend URL receives launcher IPC; arbitrary remote pages do not.",
	"windows": ["main"],
	"remote": {
		"urls": ["http://127.0.0.1:*"]
	},
	"permissions": [
		"core:default",
		"dialog:allow-open",
		"allow-select-workspace",
		"allow-backend-url",
		"allow-core-list-instances",
		"allow-core-plan-launch",
		"allow-launcher-list-pack-instances",
		"allow-launcher-delete-pack-instance",
		"allow-launcher-boot",
		"allow-launcher-cancel",
		"allow-auth-login",
		"allow-auth-logout",
		"allow-auth-status"
	]
}
