{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Packwand",
	"version": "0.1.0",
	"identifier": "net.nostalgica.packwand",
	"build": {
		"beforeDevCommand": "go run -C ../../.. . gui --no-open --port 8654",
		"devUrl": "http://127.0.0.1:8654",
		"frontendDist": "../boot"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Packwand",
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
			"dangerousDisableAssetCspModification": false
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Utility",
		"shortDescription": "Multi-pack Minecraft modpack manager",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": [
			"binaries/packwand"
		]
	}
}
