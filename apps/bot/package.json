{
	"name": "@reverie/pineapple",
	"version": "1.0.0",
	"description": "Pineapple — the Reverie Projects Discord bot.",
	"type": "module",
	"private": true,
	"scripts": {
		"deploy": "bun src/index.ts --deploy-commands",
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . && prettier --check .",
		"fix": "eslint . --fix && prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.2.1",
		"@types/pg": "^8.15.5",
		"drizzle-kit": "^0.31.4",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"jiti": "^2.5.1",
		"prettier": "^3.6.2",
		"typescript": "^5.5.3",
		"typescript-eslint": "^8.39.1"
	},
	"dependencies": {
		"@crowdin/crowdin-api-client": "^1.46.0",
		"@types/express": "^5.0.3",
		"cron": "^4.3.3",
		"discord.js": "^14.25.1",
		"dotenv": "^17.2.1",
		"drizzle-orm": "^0.45.2",
		"express": "^5.1.0",
		"pg": "^8.16.3",
		"uuid": "^14.0.0"
	}
