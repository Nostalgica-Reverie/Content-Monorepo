/* packwandc syscall table -- the single source of truth. See packwandc.md 4.
 *
 * DELIBERATELY NO INCLUDE GUARD. This file is included repeatedly, each time
 * with a different PWC_SYSCALL definition, to generate a different artifact:
 *
 *   uapi/pwc_syscall.h   the number enum and the typed prototypes
 *   kernel/syscall.c     the dispatch table
 *   scripts/gen-syscalls.sh -> crates/packwandc-sys/src/bindings.rs
 *                        the Rust extern block (checked in, diffed in CI)
 *   tests/golden/syscalls.txt
 *                        the frozen number ledger
 *
 * Because the C artifacts include this file directly rather than being
 * generated from it, the number enum and the dispatch table CANNOT drift from
 * each other. Only the Rust binding and the golden ledger are generated, and
 * CI fails if either differs from a fresh regeneration.
 *
 * FORMAT
 *   PWC_SYSCALL(nr, name, module, return_type, parameters...)
 *
 * RULES (packwandc.md 4.2)
 *   - Numbers are APPEND-ONLY. Never reused, never renumbered.
 *   - Removing a syscall burns its number forever. The mechanism is a
 *     PWC_SYSCALL_RESERVED(nr) entry that expands to nothing in the C
 *     consumers and to a PWC_ENOSYS stub in the Rust binding. It is NOT
 *     implemented yet: nothing has been removed, and defining an unused macro
 *     trips -Wunused-macros (packwandc.md 7.2), which is the gate correctly
 *     refusing speculative machinery. The first removal adds
 *     PWC_SYSCALL_RESERVED handling to all four consumers listed above, in
 *     the same commit as the removal.
 *   - Parameters are written as ordinary C, one type + one name each. The
 *     generator parses them, so exotic declarator syntax (function pointers,
 *     arrays) is not permitted here -- pass a pointer to a struct instead.
 *   - Ranges are reserved per module so numbers stay grep-able:
 *       1-15    core        16-31   pwfs      32-47   pwproc
 *       48-63   pwkeys      64-79   pwipc     80-95   pwinput
 *       96-111  pwnotify    112-127 pwtray    128-143 pwdlg
 *       144-159 pwide       160-175 pwwin     176-191 pwgpu
 */

/* --- core (1-15) ------------------------------------------------------- */

/* Report the ABI version the compiled kernel implements. The host calls this
 * first and refuses to boot on a major mismatch (packwandc.md 4.2). */
PWC_SYSCALL(1, pwc_sys_version, core, pwc_status, uint32_t *out_major, uint32_t *out_minor)

/* Map a status code to a stable, static, never-NULL identifier such as
 * "PWC_EINVAL". Intended for logs and test assertions, not user-facing text.
 * Unknown codes yield "PWC_EUNKNOWN" rather than NULL, so callers never need
 * a null check. */
PWC_SYSCALL(2, pwc_sys_status_name, core, const char *, pwc_status status)
PWC_SYSCALL(3, pwc_handle_close, core, pwc_status, pwc_handle_t h)
PWC_SYSCALL(4, pwc_handle_dup, core, pwc_status, pwc_handle_t h, uint32_t rights, pwc_handle_t *out)
PWC_SYSCALL(5, pwc_wait, core, pwc_status, pwc_waitent *ents, size_t n, int64_t timeout_ms, size_t *out_ready)
PWC_SYSCALL(6, pwc_last_error_get, core, const pwc_error_detail *, void)

/* --- pwfs (16-31) ------------------------------------------------------ */
PWC_SYSCALL(16, pwc_fs_validate_relative, pwfs, pwc_status, const uint8_t *path, size_t path_len)
PWC_SYSCALL(17, pwc_fs_read, pwfs, pwc_status, const uint8_t *root, size_t root_len, const uint8_t *path, size_t path_len, uint8_t *buffer, size_t capacity, size_t *out_len)
PWC_SYSCALL(18, pwc_fs_atomic_write, pwfs, pwc_status, const uint8_t *root, size_t root_len, const uint8_t *path, size_t path_len, const uint8_t *content, size_t content_len)
PWC_SYSCALL(19, pwc_fs_watch_open, pwfs, pwc_status, const uint8_t *root, size_t root_len, pwc_handle_t *out)
PWC_SYSCALL(20, pwc_fs_watch_read, pwfs, pwc_status, pwc_handle_t watch, size_t *out_events)
PWC_SYSCALL(21, pwc_fs_watch_close, pwfs, pwc_status, pwc_handle_t watch)
/* --- pwproc (32-47) ---------------------------------------------------- */
PWC_SYSCALL(32, pwc_proc_adopt, pwproc, pwc_status, uint32_t pid, pwc_handle_t *out)
PWC_SYSCALL(33, pwc_proc_kill, pwproc, pwc_status, pwc_handle_t process)
PWC_SYSCALL(34, pwc_proc_exists, pwproc, pwc_status, uint32_t pid, uint32_t *out_alive)
/* --- pwkeys (48-63) ---------------------------------------------------- */
PWC_SYSCALL(48, pwc_keys_save, pwkeys, pwc_status, const uint8_t *secret, size_t secret_len)
PWC_SYSCALL(49, pwc_keys_load, pwkeys, pwc_status, uint8_t *buffer, size_t capacity, size_t *out_len)
PWC_SYSCALL(50, pwc_keys_clear, pwkeys, pwc_status, void)
/* --- pwipc (64-79) ----------------------------------------------------- */
PWC_SYSCALL(64, pwc_ipc_port_create, pwipc, pwc_status, pwc_handle_t *out)







