{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Packwand",
  "version": "26.2.0",
  "identifier": "net.nostalgica.packwand",
  "build": {
    "beforeDevCommand": "bun --cwd frontend dev",
    "beforeBuildCommand": "bun --cwd frontend build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Packwand",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "resources": {
      "../../packwand-installer/build/dist/packwiz-installer.jar": "resources/packwiz-installer.jar",
      "../target/release/packwand.exe": "packwand.exe"
    }
  }
}
