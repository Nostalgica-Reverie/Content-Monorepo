{
	"lexicon": 1,
	"id": "net.nostalgica.packwand.image",
	"defs": {
		"main": {
			"type": "record",
			"key": "tid",
			"record": {
				"type": "object",
				"required": ["image", "createdAt"],
				"properties": {
					"image": {
						"type": "blob",
						"accept": ["image/png", "image/jpeg", "image/webp", "image/gif"],
						"maxSize": 10485760
					},
					"caption": { "type": "string", "maxGraphemes": 512, "maxLength": 5120 },
					"createdAt": { "type": "string", "format": "datetime" }
				}
			}
		}
	}
}
