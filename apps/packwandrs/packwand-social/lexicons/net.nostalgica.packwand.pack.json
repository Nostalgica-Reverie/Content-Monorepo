{
	"lexicon": 1,
	"id": "net.nostalgica.packwand.pack",
	"defs": {
		"main": {
			"type": "record",
			"key": "tid",
			"record": {
				"type": "object",
				"required": ["name", "manifest", "createdAt"],
				"properties": {
					"name": { "type": "string", "maxGraphemes": 128, "maxLength": 1280 },
					"description": { "type": "string", "maxGraphemes": 512, "maxLength": 5120 },
					"manifest": { "type": "ref", "ref": "#manifestSummary" },
					"tangledRepo": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
					"gitRemote": { "type": "string", "maxLength": 2048 },
					"createdAt": { "type": "string", "format": "datetime" }
				}
			}
		},
		"manifestSummary": {
			"type": "object",
			"required": ["id", "type", "version"],
			"properties": {
				"id": { "type": "string", "maxLength": 256 },
				"type": { "type": "string", "knownValues": ["modpack", "resourcepack", "datapack"] },
				"version": { "type": "string", "maxLength": 128 },
				"minecraftVersion": { "type": "string", "maxLength": 128 },
				"loader": { "type": "string", "maxLength": 128 },
				"environment": { "type": "string", "maxLength": 128 },
				"variants": {
					"type": "array",
					"maxLength": 64,
					"items": { "type": "string", "maxLength": 128 }
				}
			}
		}
	}
}
