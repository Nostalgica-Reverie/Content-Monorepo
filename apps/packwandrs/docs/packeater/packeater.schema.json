{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Packeater folder marker",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "default": 1 },
    "enabled": { "type": "boolean", "default": true },
    "output": { "type": "string" },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recompressCompressedFiles": { "type": "boolean", "default": true },
        "deduplicateFiles": { "type": "boolean", "default": true },
        "zipIterations": { "type": "integer", "minimum": 0, "maximum": 255, "default": 30 },
        "imageIterations": { "type": "integer", "minimum": 0, "maximum": 255, "default": 15 },
        "nbtIterations": { "type": "integer", "minimum": 0, "maximum": 255, "default": 20 }
      }
    },
    "lossy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "png": { "type": "boolean", "default": true },
        "pngPalette": { "enum": ["lossless", "auto", "four_bit", "eight_bit"], "default": "eight_bit" },
        "pngDithering": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "downsizeSingleColorImages": { "type": "boolean", "default": true },
        "audio": { "type": "boolean", "default": true },
        "audioQuality": { "type": "number", "minimum": -2, "maximum": 10, "default": 0 },
        "audioSampleRate": { "type": ["integer", "null"], "minimum": 1, "default": 32000 },
        "audioChannels": { "enum": [null, 1, 2], "default": null }
      }
    }
  }
}
