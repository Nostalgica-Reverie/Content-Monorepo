{
	"name": "@lasting-legacy/packwand-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"core:build": "cd core && gleam build --target javascript",
		"core:check": "cd core && gleam check --target javascript",
		"core:test": "cd core && gleam test --target javascript",
		"dev": "bun run core:build && vite --host 127.0.0.1 --port 1420 --strictPort",
		"build": "bun run core:build && vue-tsc --noEmit && vite build",
		"check": "bun run core:check && vue-tsc --noEmit",
		"test": "bun run core:test && bun test tests"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@spyglassmc/mcdoc": "^0.3.56",
		"@tauri-apps/api": "^2.9.1",
		"monaco-editor": "^0.56.0",
		"pinia": "^3.0.0",
		"vue": "^3.5.13",
		"vue-router": "^4.6.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vue/compiler-sfc": "^3.5.40",
		"sass": "^1.102.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.2",
		"vue-tsc": "^3.1.5"
	}
}
