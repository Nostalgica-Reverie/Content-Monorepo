    "tab.inactiveBackground": "#292c36",
    "statusBar.background": "#191c26",
    "statusBar.foreground": "#c8cddd",
    "titleBar.activeBackground": "#191c26",
    "titleBar.activeForeground": "#f5f1ff",
    "panel.background": "#171922",
    "panel.border": "#383d4a",
    "input.background": "#191c26",
    "input.border": "#414654",
    "list.hoverBackground": "#3a354c",
    "list.activeSelectionBackground": "#4b4263",
    "button.background": "#765cc4",
