  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8991a3", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#b9a4ff" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#79d6b0" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#c8d990" } },
    { "scope": ["entity.name.type", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#92c5ff" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#79bfff" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#e8eaf2" } },
    { "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#f0a6c8" } },
    { "scope": ["punctuation", "meta.brace", "keyword.operator"], "settings": { "foreground": "#989faf" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ffb3bf", "background": "#5c3241" } }
  ]
}
