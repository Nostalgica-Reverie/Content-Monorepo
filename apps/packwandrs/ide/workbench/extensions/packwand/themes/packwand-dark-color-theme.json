    "editor.background": "#1f222a",
    "editor.foreground": "#e8eaf2",
    "editor.lineHighlightBackground": "#292c36",
    "editor.selectionBackground": "#63538a88",
    "editorCursor.foreground": "#b9a4ff",
    "editorLineNumber.foreground": "#686f80",
    "editorLineNumber.activeForeground": "#c8cddd",
    "editorGroupHeader.tabsBackground": "#30333e",
    "tab.activeBackground": "#1f222a",
