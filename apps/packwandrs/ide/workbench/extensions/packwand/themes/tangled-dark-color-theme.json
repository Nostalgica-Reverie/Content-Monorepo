  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6c7086", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["entity.name.type", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#cdd6f4" } },
    { "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["punctuation", "meta.brace", "keyword.operator"], "settings": { "foreground": "#94e2d5" } },
    { "scope": ["constant.language.boolean", "support.constant"], "settings": { "foreground": "#fab387" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f38ba8", "background": "#4c1d2d" } }
  ],
  "semanticTokenColors": {
    "comment": "#6c7086",
    "class": "#f9e2af",
    "enum": "#f9e2af",
    "function": "#89b4fa",
    "interface": "#f9e2af",
    "keyword": "#cba6f7",
    "method": "#89b4fa",
    "number": "#a6e3a1",
    "parameter": "#cdd6f4",
    "property": "#89dceb",
    "string": "#a6e3a1",
    "type": "#f9e2af",
    "variable": "#cdd6f4"
  }
}
