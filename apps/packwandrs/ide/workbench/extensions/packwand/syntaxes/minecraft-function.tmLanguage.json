{
  "name": "Minecraft Function",
  "scopeName": "source.minecraft.function",
  "patterns": [
    { "name": "comment.line.number-sign.minecraft", "match": "#.*$" },
    { "name": "keyword.control.command.minecraft", "match": "^\\\\s*/?([a-z_]+)\\\\b" },
    { "name": "variable.language.selector.minecraft", "match": "@[pares](?:\\\\[[^]]*\\\\])?" },
    { "name": "entity.name.resource-location.minecraft", "match": "\\\\b[a-z0-9_.-]+:[a-z0-9_./-]+\\\\b" },
    { "name": "string.quoted.double.minecraft", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.minecraft", "match": "\\\\\\\\." }] },
    { "name": "constant.numeric.minecraft", "match": "(?<![A-Za-z0-9_])[-+]?(?:[0-9]+(?:\\\\.[0-9]+)?)(?![A-Za-z0-9_])" },
    { "name": "constant.language.boolean.minecraft", "match": "\\\\b(?:true|false)\\\\b" }
  ]
}
