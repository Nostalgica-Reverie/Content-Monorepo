{
  "name": "packwand",
  "displayName": "Packwand",
  "description": "Minecraft pack editing support and Packwand workbench defaults.",
  "version": "26.2.0",
  "publisher": "lasting-legacy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.126.0"
  },
  "categories": ["Programming Languages", "Themes"],
  "contributes": {
    "languages": [
      {
        "id": "packwand-toml",
        "aliases": ["Packwand TOML", "TOML"],
        "extensions": [".toml"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "minecraft-function",
        "aliases": ["Minecraft Function", "mcfunction"],
        "extensions": [".mcfunction"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "packwand-toml",
        "scopeName": "source.packwand.toml",
        "path": "./syntaxes/packwand-toml.tmLanguage.json"
      },
      {
        "language": "minecraft-function",
        "scopeName": "source.minecraft.function",
        "path": "./syntaxes/minecraft-function.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Packwand Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/packwand-dark-color-theme.json"
      },
      {
        "label": "Tangled Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/tangled-dark-color-theme.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "packeater.json",
        "url": "./schemas/packeater.schema.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Packwand Dark",
      "workbench.startupEditor": "none",
      "editor.minimap.enabled": false,
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": true,
      "files.trimTrailingWhitespace": true
    }
  }
}
