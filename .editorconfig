# EditorConfig — https://editorconfig.org
# Root settings for the whole platform; matches .gitattributes (LF everywhere).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.{kt,kts,java,gradle}]
indent_size = 4

[*.rs]
indent_size = 4

# C, headers, and Objective-C (arch/darwin) for apps/packwandrs/packwandc.
# Must match IndentWidth in packwandc/.clang-format, or clang-format and the
# editor will fight over every save.
[*.{c,h,m}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
