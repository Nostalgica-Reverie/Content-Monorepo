# Build output and dependencies.
**/node_modules/
**/dist/
**/target/
**/build/
**/.svelte-kit/
**/.vitepress/cache/
**/.vitepress/dist/
apps/packwandrs/frontend/core/build/
# Tauri regenerates these from tauri.conf.json and the capability files.
apps/packwandrs/src-tauri/gen/

# Lockfiles are owned by their package managers.
bun.lock
Cargo.lock
flake.lock
**/gradle/wrapper/

# Content directories are data, not code (see newstandards.md). Two separate
# reasons to keep Prettier out of them:
#
#  - Packwand owns `*.pw.json` and `index.json` and rewrites them wholesale on
#    every refresh, so formatting them produces churn that `packwand refresh`
#    immediately undoes.
#  - The rest is Minecraft game data — loot tables, models, lang files,
#    `.mcmeta` — much of it copied verbatim from upstream mods. Reformatting it
#    destroys the ability to diff against upstream and gains nothing.
#
# The hand-written manifests are re-included below, because those we do own.
modpacks/
resourcepacks/
datapacks/
!modpacks/*/manifest.json
!modpacks/*/manifest-experimental.json
!resourcepacks/*/manifest.json
!resourcepacks/*/manifest-experimental.json
!datapacks/*/manifest.json
!datapacks/*/manifest-experimental.json

# Mod source trees keep their own Gradle/Kotlin formatting; only the manifests
# are ours to format.
mods/*/src/
mods/*/versions/

# Test fixtures are data, not code. A fixture's bytes are the thing under test —
# packsquash's JSON minifier asserts against these exact files, and reformatting
# them makes seven of its tests fail.
**/tests/fixtures/
**/testdata/
**/__snapshots__/

# Prettier parses .hbs with its Glimmer parser, which rejects a Handlebars block
# used inside an HTML attribute -- valid Handlebars it simply cannot represent.
# See apps/mod-browser-webview/about.hbs:60.
*.hbs

# Vendored sources that upstream owns. Reformatting them destroys the ability to
# diff against upstream and gains nothing.
packages/packwand2nix/
apps/packwandrs/crates/packsquash/
apps/packwandrs/crates/packsquash_cli/
apps/packwandrs/crates/packeater_cli/
apps/packwandrs/docs/packeater/

# Local reference checkouts of Modrinth's launcher, kept untracked for
# comparison while porting. Not ours to format.
app/
app-frontend/
