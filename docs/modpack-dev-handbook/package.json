{
  "name": "modpack-dev-handbook",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "docs:commands": "node ../packwand/build-commands.mts && node ../packwand/check-command-coverage.mts",
    "docs:index": "node scripts/prepare-docs.mts",
    "dev": "bun run docs:index && vite dev",
    "build": "bun run docs:commands && bun run docs:index && vite build",
    "preview": "vite preview",
    "generate:usefulmods": "node scripts/usefulMods.mts",
    "format": "prettier --write \\\"src/**/*.{svelte,ts,svx,md}\\\" \\\"scripts/*.{mts,ts}\\\"",
    "check": "bun run docs:commands && bun run docs:index && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run docs:index && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.46.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.9.5",
    "consola": "^3.4.2",
    "fast-glob": "^3.3.3",
    "lightningcss": "^1.30.2",
    "mdsvex": "^0.12.6",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.2",
    "super-sitemap": "^1.0.12",
    "svelte": "^5.39.11",
    "svelte-check": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.4",
    "@iconify-json/tabler": "^1.2.23",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "gray-matter": "^4.0.3",
    "nbtify": "^2.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-admonitions": "^1.2.1",
    "remark-code-titles": "^0.1.2",
    "shiki": "^3.23.0",
    "sk-seo": "^0.5.4",
    "tailwindcss": "^4.1.14",
    "unplugin-icons": "^22.5.0"
  }
}
