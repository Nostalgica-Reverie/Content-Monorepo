var mods = ModListUtils.getCurrentModListMappedToModId();

var m_embeddium = mods.get("embeddium");
if (m_embeddium != null) {
    var warn = Startup.addCrashWarning("⚠️ <strong>Embeddium Not Supported</strong>\n\nEmbeddium is not supported by Re-Console+.");
    warn.withModActions(m_embeddium);
    Startup.markForCrash();
}

var m_legacy_mipmaps = mods.get("legacy-mipmaps");
if (m_legacy_mipmaps != null) {
    var warn = Startup.addBootWarning("⚠️ <strong>Legacy Mipmaps installed</strong>\n\nLegacy Mipmaps is abandoned and is not supported!");
    warn.withModActions(m_legacy_mipmaps);
}

var m_nochatreports = mods.get("nochatreports");
if (m_nochatreports != null) {
    var warn = Startup.addCrashWarning("⚠️ <strong>No Chat Reports installed</strong>\n\nNo Chat Reports is superseded by No Prying Eyes, and adding it will introduce compatibility and performance issues.");
    warn.withModActions(m_nochatreports);
    Startup.markForCrash();
}

var m_noisium = mods.get("noisium");
if (m_noisium != null) {
    var warn = Startup.addCrashWarning("⚠️ <strong>Noisium not supported</strong>\n\nNoisium is not supported, as the mod does not have significant performance boost and is superseded by Fast Noise!");
    warn.withModActions(m_noisium);
    Startup.markForCrash();
}

var m_notenoughcrashes = mods.get("notenoughcrashes");
if (m_notenoughcrashes != null) {
    var warn = Startup.addCrashWarning("⚠️ <strong>Not Enough Crashes installed</strong>\n\nYou have added the Not Enough Crashes mod. This may cause critical stability errors.");
    warn.withModActions(m_notenoughcrashes);
    Startup.markForCrash();
}